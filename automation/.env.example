# Copy outside Git for deployment; generate all values with a cryptographically secure secret generator.
N8N_DB_PASSWORD=replace-with-random-secret
N8N_ENCRYPTION_KEY=replace-with-independent-random-secret-at-least-32-characters
N8N_HOST=automation.example.co.ke
# JATA app deployment only; configure an HTTPS n8n Webhook URL and same secret on both systems.
JATA_N8N_EVENTS_URL=https://automation.example.co.ke/webhook/jata-events
JATA_AUTOMATION_HMAC_SECRET=replace-with-an-independent-random-secret-at-least-32-characters
