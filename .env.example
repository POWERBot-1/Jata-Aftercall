# JATA AFTERCALL — environment template
# Copy to .env.local for development. Never commit .env* with real secrets.
# All secrets are injected via Vercel/Cloudflare dashboard in production.

# ── Database ──
# Neon free-tier Postgres (or any Postgres). Prisma requires a single URL.
# Example: postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/jata_aftercall?schema=public"

# ── Auth ──
# Random 32+ char secret for signing session JWTs (generate: openssl rand -base64 32)
AUTH_SECRET="replace-with-strong-random-secret-at-least-32-chars"
# Public base URL — used to generate canonical business URLs and OAuth callbacks
# Dev: http://localhost:3000  Free deploy: https://jata-aftercall.vercel.app  Future: https://jata.link
PUBLIC_BASE_URL="http://localhost:3000"
# NextAuth-compatible alias (some tooling expects it)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="same-as-AUTH_SECRET"

# ── Paystack — JATA ATLAS merchant 2006074 ──
# Merchant ID is configuration, not a secret (spec §53)
PAYSTACK_MERCHANT_ID="2006074"
# Secret and public keys — server secret MUST stay server-side; public key may be exposed for inline checkout
# Obtain from https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY="sk_test_xxx"
PAYSTACK_PUBLIC_KEY="pk_test_xxx"
# Paystack webhook URL to configure in dashboard: https://<PUBLIC_BASE_URL>/api/paystack/webhook

# ── Admin ──
# Comma-separated admin emails (these users get ADMIN role on register/login seed)
ADMIN_EMAILS="admin@jata.link"

# ── Website Studio AI — OPTIONAL ──
# The Studio works with no keys at all: the built-in "jata-local" provider composes branded
# artwork and copy on the server and every image it produces is labelled JATA artwork, never a
# photo of your product. Configure a vendor below to have real photos generated instead.
#
# Which provider to use for each job: auto | jata-local | openai | gemini
#   auto = prefer a configured vendor, and fall back to the built-in provider when no key is set.
# These are SERVER-ONLY values. They are read in lib/ai/registry.ts and are never sent to the
# browser; nothing in the Studio or the public site can read them.
JATA_AI_IMAGE_PROVIDER="auto"
JATA_AI_TEXT_PROVIDER="auto"

# OpenAI (image + copy). Leave blank to keep the built-in provider.
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_IMAGE_MODEL="gpt-image-1"      # default when unset
OPENAI_TEXT_MODEL="gpt-4o-mini"       # default when unset

# Google Gemini (image + copy). Leave blank to keep the built-in provider.
# GOOGLE_API_KEY is accepted as an alias for GEMINI_API_KEY.
GEMINI_API_KEY=""
GEMINI_IMAGE_MODEL="gemini-2.5-flash-image"   # default when unset
GEMINI_TEXT_MODEL="gemini-2.5-flash"          # default when unset

# Monthly per-business allowance is fixed in code (lib/ai/quota.ts): 40 images, 40 photo
# improvements and 400 copy assists per UTC month on Interactive Business, and a small preview
# allowance before payment. Usage is counted from AiGeneration rows in the database, so it
# survives restarts and cannot be reset by refreshing the browser.

# ── Optional ──
NODE_ENV="development"

# ── JATA Payment Wallet (Business POS §14–§17, §58, §94, §129) ──
# The POS takes payments into the MERCHANT'S own account (M-PESA till/PayBill, bank, Paystack).
# Merchants never see any of this: JATA owns the provider connection centrally. Every value below
# is OPTIONAL — with none of them set, the wallet still works and tells the truth: it saves the
# merchant's destination, shows the customer how to pay, and states that automatic confirmation
# is not available in this deployment. Nothing here may be sent to a browser (§58).
#
# ── M-PESA (Safaricom Daraja) ──────────────────────────────────────────────────────────────
# Fail-closed. There is no default environment and no fallback between sandbox and production:
# if anything below is missing or malformed, the connector reports NOT READY (naming the variable,
# never the value) and the wallet shows customers how to pay instead of raising a prompt.
#
# KEEP SANDBOX AND PRODUCTION SEPARATE IN VERCEL: set MPESA_ENV=production and every production
# credential ONLY for the Vercel "Production" environment; use MPESA_ENV=sandbox and the Daraja
# sandbox credentials for "Preview"/"Development". A production connector on a Preview or
# Development deployment is refused outright. Never commit real values to this file.
#
# Which Daraja host to talk to — exactly "sandbox" or "production" (required; no default).
MPESA_ENV=""
# Daraja app credentials from https://developer.safaricom.co.ke (sandbox app or the approved
# production app — they are different credentials).
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
# The shortcode the Daraja app is approved for: 5–7 digits. For a Buy Goods till this is the head-
# office (store) number and each till is sent as PartyB. 174379 is Safaricom's PUBLIC SANDBOX
# shortcode — it is refused with MPESA_ENV=production and is NOT JATA ATLAS's production shortcode.
MPESA_SHORTCODE=""
# Lipa na M-PESA Online passkey for that shortcode (sandbox passkey in sandbox, the production
# passkey Safaricom issues at go-live in production).
MPESA_PASSKEY=""
# Shared secret carried as ?token=… in JATA's callback URLs (Daraja does not sign callbacks).
# 24–128 URL-SAFE characters: A–Z a–z 0–9 _ -   Generate with:  openssl rand -hex 24
# Do NOT use `openssl rand -base64` — its + / = characters break the callback URL.
MPESA_CALLBACK_TOKEN=""
# The public https origin Daraja callbacks point at (PUBLIC_BASE_URL above, else NEXTAUTH_URL).
# It must be publicly reachable: localhost, plain http and private addresses are refused. Unset
# means the callback URLs cannot be built and the connector is NOT READY — it never falls back to
# localhost. By default JATA hands Safaricom neutral paths (no "mpesa"/"safaricom" in them):
#   <origin>/api/payments/webhooks/daraja/{stk|confirmation|validation}?token=…
# Optional URL overrides, used VERBATIM — each must be a public https URL, must END IN /stk,
# /confirmation or /validation respectively, and must carry ?token=<MPESA_CALLBACK_TOKEN> itself.
MPESA_STK_CALLBACK_URL=""
MPESA_C2B_CONFIRMATION_URL=""
MPESA_C2B_VALIDATION_URL=""
# Optional hardening: comma-separated EXACT source IP addresses (no CIDR ranges) allowed to post
# callbacks. Read from x-forwarded-for, which Vercel sets to the client's public IP. Empty = not
# enforced (the token is the authentication). See JATA_AFTERCALL_MPESA_READINESS.md before using.
MPESA_ALLOWED_IPS=""
# Reversals (refunds of M-PESA payments) only — the API operator ("initiator") and its
# SecurityCredential, i.e. the initiator password encrypted with Safaricom's certificate FOR THIS
# ENVIRONMENT, base64 encoded. The initiator needs the reversal role on the shortcode. Without both,
# reversals are refused locally and nothing is sent; collections still work.
MPESA_INITIATOR_NAME=""
MPESA_SECURITY_CREDENTIAL=""

# Bank payments. Without an authorized connector, a bank destination is saved and instructions are
# shown; JATA never claims a bank account is live-connected when it is not (§16, §120).
BANK_CONNECTOR_URL=""
BANK_CONNECTOR_API_KEY=""

# Paystack is shared with the rest of JATA (PAYSTACK_SECRET_KEY above). The wallet uses the same
# key; its webhook endpoint is /api/payments/webhooks/paystack.

# Test mode. "on" lets a NON-production deployment accept unsigned Daraja-shaped callbacks for local
# testing and labels records as practice. It is ignored when MPESA_ENV=production or on a Vercel
# Production deployment, so it can never weaken a live system. "off"/unset derives test mode from
# what is connected: only a LIVE connector (M-PESA production, or a Paystack sk_live_ key) is live;
# a fully configured M-PESA SANDBOX connector is still test mode (§94). Leave unset in production.
JATA_PAYMENTS_TEST_MODE=""

# Optional outbound message gateway for merchant/customer SMS, WhatsApp or e-mail about a payment
# (POS/in-app messages always work; without a gateway, external channels are recorded as SKIPPED,
# never as sent). A failed message never changes whether a payment is paid (§66, §100).
JATA_NOTIFICATION_GATEWAY_URL=""
JATA_NOTIFICATION_GATEWAY_TOKEN=""
