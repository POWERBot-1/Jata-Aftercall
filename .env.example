# JATA AFTERCALL — environment template
# Copy to .env.local for development. Never commit .env* with real secrets.
# All secrets are injected via Vercel/Cloudflare dashboard in production.

# ── Database ──
# Neon free-tier Postgres (or any Postgres). Prisma requires a single URL.
# Example: postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/jata_aftercall?schema=public"
# Migrations only. Prisma Migrate takes a session-level advisory lock, which PgBouncer's transaction
# pooling does not reliably hold (P1002, or P3009 on the next deploy). On Neon, DATABASE_URL is the
# pooled host (`-pooler`) and DIRECT_URL is the same host WITHOUT `-pooler`. Leave it unset locally and
# in CI: scripts/lib/prisma-env.sh defaults it to DATABASE_URL, and scripts/migrate.sh refuses to
# migrate if that default would send migrations through a pooler.
DIRECT_URL=""

# ── Auth ──
# Random 32+ char secret for signing session JWTs (generate: openssl rand -base64 32)
AUTH_SECRET="replace-with-strong-random-secret-at-least-32-chars"
# Public base URL — used to generate canonical business URLs and OAuth callbacks
# Dev: http://localhost:3000  Free deploy: https://jata-aftercall.vercel.app  Future: https://jata.link
PUBLIC_BASE_URL="http://localhost:3000"
# NextAuth-compatible alias (some tooling expects it)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="same-as-AUTH_SECRET"
# Password recovery delivery — REQUIRED for /forgot-password to work. When unset, the reset API
# answers 503 ("not available in this deployment") and no email can ever be sent. Configure a
# verified SMTP sender and TLS-capable smtp:// or smtps:// endpoint in the platform secret store
# only (never commit real credentials). Recovery links are built from the canonical base URL chain:
# PUBLIC_BASE_URL (non-localhost) -> NEXTAUTH_URL -> the Vercel production URL, always https in
# production. Optional PASSWORD_RESET_SMTP_CA pins a PEM CA bundle for relays with private CAs.
PASSWORD_RESET_SMTP_URL=""
PASSWORD_RESET_FROM=""
# PASSWORD_RESET_SMTP_CA=""

# ── Paystack — JATA ATLAS merchant 2006074 ──
# Merchant ID is configuration, not a secret (spec §53)
PAYSTACK_MERCHANT_ID="2006074"
# Secret and public keys — server secret MUST stay server-side; public key may be exposed for inline checkout
# Obtain from https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY="sk_test_xxx"
PAYSTACK_PUBLIC_KEY="pk_test_xxx"
# Paystack webhook URL to configure in dashboard: https://<PUBLIC_BASE_URL>/api/paystack/webhook

# ── Admin ──
# Comma-separated admin emails (these users get ADMIN role on register/login seed)
ADMIN_EMAILS="admin@jata.link"

# ── Website Studio AI — OPTIONAL ──
# The Create workspace (Website Studio) derives everything it offers from the keys below plus
# durable media storage: with no storage provider approved/implemented, generation, AI photo
# editing and photo uploads honestly report "unavailable" in the UI, while the ready category
# images keep working. Animation/video have no provider adapter yet. See
# IMAGE_FIRST_STUDIO_POS_2026-10-26.md and STORAGE_DECISION.md. There is no separate
# "creative engine" key to set, and nothing here may be exposed to the browser.

# The Studio works with no keys at all: the built-in "jata-local" provider composes branded
# artwork and copy on the server and every image it produces is labelled JATA artwork, never a
# photo of your product. Configure a vendor below to have real photos generated instead.
#
# Which provider to use for each job: auto | jata-local | openai | gemini
#   auto = prefer a configured vendor, and fall back to the built-in provider when no key is set.
# These are SERVER-ONLY values. They are read in lib/ai/registry.ts and are never sent to the
# browser; nothing in the Studio or the public site can read them.
JATA_AI_IMAGE_PROVIDER="auto"
JATA_AI_TEXT_PROVIDER="auto"

# OpenAI (image + copy). Leave blank to keep the built-in provider.
# NOTE (2026-10-26): gpt-image-1 was retired by OpenAI on 2026-10-23. If you enable OpenAI,
# set OPENAI_IMAGE_MODEL to a current image model (e.g. gpt-image-1.5) — do not rely on the
# legacy default. Verify current model names/pricing on OpenAI.com before enabling.
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_IMAGE_MODEL="gpt-image-1"      # legacy default when unset — override when enabling (see NOTE)
OPENAI_TEXT_MODEL="gpt-4o-mini"       # default when unset

# Google Gemini (image + copy). Leave blank to keep the built-in provider.
# GOOGLE_API_KEY is accepted as an alias for GEMINI_API_KEY.
GEMINI_API_KEY=""
GEMINI_IMAGE_MODEL="gemini-2.5-flash-image"   # default when unset
GEMINI_TEXT_MODEL="gemini-2.5-flash"          # default when unset

# Monthly per-business allowance is fixed in code (lib/ai/quota.ts): 40 images, 40 photo
# improvements and 400 copy assists per UTC month on Interactive Business, and a small preview
# allowance before payment. Usage is counted from AiGeneration rows in the database, so it
# survives restarts and cannot be reset by refreshing the browser.

# ── Durable media storage — Cloudflare R2 selected 2026-10-26; leave unset until configured ──
# Uploads and generated images can only be *saved* once R2 is configured for the environment
# (owner runbook: R2_SETUP.md; decision record: STORAGE_DECISION.md addendum). The application
# routes media through lib/storage and turns these capabilities on by itself when ALL of the
# variables below are present; otherwise it fails closed and the Studio says so. Credentials
# are created by the owner in the Cloudflare dashboard, scoped to a single bucket, and are
# SERVER-ONLY — never commit real values or expose them to the browser. Preview and Production
# use separate buckets/tokens; production activation is a separate owner gate.
# JATA_STORAGE_PROVIDER=""          # "cloudflare-r2" to enable durable media in this environment
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET=""                      # e.g. jata-media-preview / jata-media-production
# R2_PUBLIC_BASE_URL=""             # r2.dev subdomain (pilot) or custom domain serving the bucket
# Application $0-first ceilings are fixed in code (lib/media/storageQuota.ts): 250 MB stored
# media per business, 5 GB globally, enforced before writes. The R2 free tier is an allowance,
# not a billing hard-cap — set Cloudflare billing notifications as the backstop.

# ── Optional ──
NODE_ENV="development"
# Rate-limit buckets are process-local and periodically pruned. X-Forwarded-For is trusted only
# when Vercel sets VERCEL=1; verify the deployment ingress overwrites that header before relying
# on IP limits. No Redis or shared rate-limit store is configured by this template.

# ── JATA Payment Wallet (Business POS §14–§17, §58, §94, §129) ──
# The POS takes payments into the MERCHANT'S own account (M-PESA till/PayBill, bank, Paystack).
# Merchants never see any of this: JATA owns the provider connection centrally. Every value below
# is OPTIONAL — with none of them set, the wallet still works and tells the truth: it saves the
# merchant's destination, shows the customer how to pay, and states that automatic confirmation
# is not available in this deployment. Nothing here may be sent to a browser (§58).
#
# Which M-PESA environment to talk to: sandbox | production (default sandbox)
MPESA_ENV="sandbox"
# Safaricom Daraja app credentials (https://developer.safaricom.co.ke). All three are required
# before JATA can prompt a customer or receive a Daraja callback.
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
# The store number that collects: a Buy Goods till or a PayBill shortcode
MPESA_SHORTCODE=""
# Lipa na M-PESA online passkey for that shortcode
MPESA_PASSKEY=""
# Shared secret appended to JATA's callback URLs (?token=…). Daraja does not sign callbacks, so
# without this JATA refuses unauthenticated callbacks rather than trusting whoever finds the URL.
MPESA_CALLBACK_TOKEN=""
# Optional URL overrides. Default: PUBLIC_BASE_URL + /api/payments/webhooks/mpesa/{stk|confirmation|validation}
MPESA_STK_CALLBACK_URL=""
MPESA_C2B_CONFIRMATION_URL=""
MPESA_C2B_VALIDATION_URL=""
# Optional hardening: comma-separated Safaricom source IPs; empty means no IP filtering
MPESA_ALLOWED_IPS=""
# B2C only (refunds/reversals paid out through M-PESA): the initiator and its SecurityCredential
MPESA_INITIATOR_NAME=""
MPESA_SECURITY_CREDENTIAL=""

# Bank payments. Without an authorized connector, a bank destination is saved and instructions are
# shown; JATA never claims a bank account is live-connected when it is not (§16, §120).
BANK_CONNECTOR_URL=""
BANK_CONNECTOR_API_KEY=""

# Paystack is shared with the rest of JATA (PAYSTACK_SECRET_KEY above). The wallet uses the same
# key; its webhook endpoint is /api/payments/webhooks/paystack.

# Test mode. "on" lets a deployment accept unsigned Daraja-shaped callbacks for local testing and
# labels records as practice; "off"/unset makes JATA refuse unauthenticated provider events and
# derive test mode from whether a live connector is configured (§94).
JATA_PAYMENTS_TEST_MODE=""

# Optional outbound message gateway for merchant/customer SMS, WhatsApp or e-mail about a payment
# (POS/in-app messages always work; without a gateway, external channels are recorded as SKIPPED,
# never as sent). A failed message never changes whether a payment is paid (§66, §100).
JATA_NOTIFICATION_GATEWAY_URL=""
JATA_NOTIFICATION_GATEWAY_TOKEN=""

# ── POS / ERP - PRO ────────────────────────────────────────────────────────────────────────────────────
# A separate product beside the Business POS (KES 3,000/month). Every value below is optional, and
# the default posture of a deployment that sets none of them is "off, and honest about it".
#
# Product switch. Unset means "on outside production, off in production". ERP_PRO_DISABLED=true wins
# over everything; when the product is off the screens return 503 with a plain explanation and no
# data is read or written behind the curtain.
ERP_PRO_ENABLED=""
ERP_PRO_DISABLED=""

# Public shop. Product links in the catalogue are signed with this secret so a customer cannot guess
# a product id. Production refuses to open a shop without a strong secret (16+ characters) and
# returns STOREFRONT_UNCONFIGURED instead of serving guessable links. Server-side only.
# The code falls back to AUTH_SECRET/NEXTAUTH_SECRET when this is unset, which is why a dedicated
# secret is recommended: rotating the auth secret should not invalidate shop links.
STOREFRONT_REF_SECRET=""

# Messaging. Dispatch refuses to reach a real phone unless this is exactly "true". The sandbox
# provider exercises the entire pipeline (queue, cost, delivery, reconciliation) without sending.
MESSAGING_LIVE_ENABLED=""
# HMAC secret for provider callbacks. Empty means every callback is refused - never trusted.
MESSAGING_WEBHOOK_SECRET=""
# Provider credentials are registered by a server-side adapter and are not read from this file. A
# deployment with no adapter registered fails closed with PROVIDER_NOT_CONFIGURED. Keep keys in the
# hosting provider's secret store.

# eTIMS. This release ships no certified adapter, so submission stays off and invoices are prepared
# and validated locally only. Setting these does not create a connection: the UI reads them and
# still refuses to claim acceptance without KRA's control number.
ETIMS_LIVE_ENABLED=""
ETIMS_ADAPTER_KEY=""

# ── JATA Qi work-ingress seam — INACTIVE, owner approval-gated (Phase 4, 2026-10-27) ──
# The in-repo seam (lib/qi) fails closed in "none" mode and has no live runtime registered:
# the Qi packages are not on the public npm registry and Qi exposes no HTTP API. Leave all of
# these unset until an owner-approved embedding/deployment decision and credential handover.
# JATAQI_AUTH_MODE="none"          # static-token | oidc | test-only | none (default none)
# JATAQI_AUTH_TOKEN=""             # server-side only; never sent to browsers, never logged
# JATAQI_ENV="sandbox"             # sandbox | production

# Agent-only account signup is disabled until the owner reviews the incomplete programme,
# privacy/retention, abuse controls and migrations. It never activates an agent or commissions.
AGENT_SELF_SERVICE_REGISTRATION_ENABLED=""

# Phone verification is disabled unless an owner-approved live messaging adapter is registered and
# separately enabled. Never put real secrets in this file. Mocks cannot prove phone ownership.
AGENT_PHONE_VERIFICATION_ENABLED=""
AGENT_VERIFICATION_PROVIDER_KEY=""
AGENT_VERIFICATION_SENDER_ID=""
AGENT_VERIFICATION_HMAC_SECRET=""

# Optional preferred WhatsApp verification adapter and APPROVED authentication template.
# An explicit template-capable live adapter must be registered by server code. Empty = unavailable.
AGENT_VERIFICATION_WHATSAPP_PROVIDER_KEY=""
AGENT_VERIFICATION_WHATSAPP_SENDER_ID=""
AGENT_VERIFICATION_WHATSAPP_TEMPLATE_NAME=""
AGENT_VERIFICATION_WHATSAPP_TEMPLATE_LANGUAGE=""
AGENT_VERIFICATION_WHATSAPP_TEMPLATE_APPROVED=""

# Meta WhatsApp Cloud API: all values are server-only. Empty/default-disabled; never commit secrets.
# Only Graph API v26.0 is supported. The approved template must be an AUTHENTICATION copy-code template.
META_WHATSAPP_CLOUD_ENABLED=""
META_WHATSAPP_GRAPH_VERSION=""
META_WHATSAPP_ACCESS_TOKEN=""
META_WHATSAPP_PHONE_NUMBER_ID=""
META_WHATSAPP_APP_SECRET=""
META_WHATSAPP_WEBHOOK_ENABLED=""
META_WHATSAPP_VERIFY_TOKEN=""

# Administrator-reviewed activation remains unavailable until separate owner approval.
AGENT_ACTIVATION_ENABLED=""
# Separately gated reviewed reinstatement; do not enable without owner approval.
AGENT_REINSTATEMENT_ENABLED=""

# Registration referral evidence only. Default off; no commissions are created.
# Explicit approved link lifetime in seconds is required; no window is supplied by default.
AGENT_REGISTRATION_REFERRALS_ENABLED=""
AGENT_REFERRAL_LINK_LIFETIME_SECONDS=""
