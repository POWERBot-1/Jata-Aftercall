generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Core ──

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  name         String?
  phone        String?
  passwordHash String
  role         Role           @default(CUSTOMER)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  ownedBusinesses Business[]
  businesses   BusinessMember[]
  payments     Payment[]
  subscriptions Subscription[]
  auditEvents  AuditEvent[]

  @@index([email])
}

enum Role {
  CUSTOMER
  ADMIN
}

model Business {
  id            String         @id @default(cuid())
  ownerId       String
  owner         User           @relation(fields: [ownerId], references: [id])
  slug          String         @unique
  name          String
  category      String
  phone         String?
  whatsapp      String?
  location      String?
  lat           Float?
  lng           Float?
  description   String?        @db.Text
  logoUrl       String?
  coverUrl      String?
  language      String?        @default("en")
  theme         String         @default("clean")
  aftercallMsg  String?
  isPublished   Boolean        @default(false)
  status        BusinessStatus @default(PENDING)
  openingHours  String?        @db.Text
  socialLinks   String?        @db.Text
  // Stage 2: opaque public referral code. Nullable + unique; minted lazily (on first eligible
  // use) so existing rows need no backfill. Never derived from tenant data.
  referralCode  String?        @unique
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  services      Service[]
  offer         Offer?
  events        AnalyticsEvent[]
  subscription  Subscription?
  payments      Payment[]
  members       BusinessMember[]
  // ── JATA Interactive Business (category-aware experience platform) ──
  experience          BusinessExperience?
  experienceVersions  ExperienceVersion[]
  draftRevisions      ExperienceDraftRevision[]
  bookings            Booking[]
  media               MediaAsset[]
  aiGenerations       AiGeneration[]
  interactiveEntitlement InteractiveBusinessEntitlement?
  aiConfiguration AIConfiguration?
  products Product[]
  productVariants ProductVariant[]
  knowledgeDocuments KnowledgeDocument[]
  faqs FAQ[]
  aiPackageEntitlement AIPackageEntitlement?
  carts Cart[]
  orders Order[]
  preOrders PreOrder[]
  merchantPaymentConfig MerchantPaymentConfig?
  notifications Notification[]
  notificationRecipients NotificationRecipient[]
  unansweredQuestions UnansweredQuestion[]
  demandInsights DemandInsight[]
  aiQualityEvents AIQualityEvent[]
  // ── JATA AFTERCALL Business POS (spec §80: additive back-relations only) ──
  posConfiguration         PosConfiguration?
  posConfigurationVersions PosConfigurationVersion[]
  posSubscription          PosSubscription?
  posEntitlement           PosEntitlement?
  posTemplates             PosTemplate[]
  posBranches              PosBranch[]
  posStaff                 PosStaff[]
  posProducts              PosProduct[]
  posInventoryItems        PosInventoryItem[]
  posInventoryMovements    PosInventoryMovement[]
  posCustomers             PosCustomer[]
  posCustomerAssets        PosCustomerAsset[]
  posSuppliers             PosSupplier[]
  posSales                 PosSale[]
  posSaleItems             PosSaleItem[]
  posPayments              PosPayment[]
  posCreditEntries         PosCreditEntry[]
  posExpenses              PosExpense[]
  posPurchases             PosPurchase[]
  posPurchaseItems         PosPurchaseItem[]
  posOrders                PosOrder[]
  posOrderItems            PosOrderItem[]
  posOrderEvents           PosOrderEvent[]
  posAuditEvents           PosAuditEvent[]

  // ── JATA Payment Wallet + Payment Orchestration (additive back-relations) ──
  paymentDestinations      PaymentDestination[]
  paymentConnections       PaymentProviderConnection[]
  paymentTransactions      PaymentTransaction[]
  paymentNotifications     PaymentNotification[]
  paymentReconciliations   PaymentReconciliation[]
  paymentRefunds           Refund[]
  paymentAuditEvents       PaymentAuditEvent[]

  @@index([ownerId])
  @@index([slug])
}

enum BusinessStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

model BusinessMember {
  id         String   @id @default(cuid())
  userId     String
  businessId String
  role       String   @default("OWNER")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, businessId])
  @@index([businessId])
}

model Service {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  title      String
  description String? @db.Text
  priceFrom  Int?
  priceLabel String?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  // ── Interactive Business service fields (§9, §12, §18) ──
  updatedAt       DateTime  @updatedAt
  imageUrl        String?   @db.Text
  category        String?
  pricingType     String    @default("FIXED")   // FIXED | QUOTE
  priceToKES      Int?                          // "from … to …" range
  durationMinutes Int?                          // Salon / automotive / consulting
  depositKES      Int?                          // Optional booking deposit
  staffName       String?                       // Where applicable
  availability    String?   @db.Text            // JSON: { days: [1..7], slots: ["09:00"] }
  bookingEnabled  Boolean   @default(true)
  isFeatured      Boolean   @default(false)
  isActive        Boolean   @default(true)

  @@index([businessId])
}

//
// Booking (§9, §29) — service businesses are never forced into a cart model.
// A booking is tenant-scoped; every read and write is filtered by businessId.
//
model Booking {
  id            String   @id @default(cuid())
  businessId    String
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  serviceId     String?
  serviceName   String
  customerName  String
  customerPhone String
  customerEmail String?
  staffName     String?
  startAt       DateTime
  endAt         DateTime?
  notes         String?  @db.Text
  // PENDING | CONFIRMED | IN_PROGRESS | COMPLETED | CANCELLED | NO_SHOW
  status        String   @default("PENDING")
  depositKES    Int      @default(0)
  // UNPAID | PAID (§27) — fulfilment never assumes payment.
  paymentStatus String   @default("UNPAID")
  paymentId     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([businessId])
  @@index([businessId, startAt])
  @@index([businessId, status])
}

model Offer {
  id         String    @id @default(cuid())
  businessId String    @unique
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  title      String
  subtitle   String?
  validUntil DateTime?
  isActive   Boolean   @default(true)
  // Interactive Business additions (§7, §8) — offer presentation inside a section.
  imageUrl   String?   @db.Text
  ctaLabel   String?
  badge      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model PageTheme {
  id     String @id @default(cuid())
  key    String @unique
  name   String
  config String @db.Text
}

model AnalyticsEvent {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  eventType  String
  source     String?
  ipHash     String?
  userAgent  String?
  createdAt  DateTime @default(now())
  // Interactive Business analytics (§31, §32): subject = product/service id; sessionHash
  // lets a conversion funnel be counted without storing personal data (§57).
  subjectId  String?
  sessionHash String?

  @@index([businessId, eventType])
  @@index([businessId, createdAt])
  @@index([businessId, eventType, createdAt])
}

model PlanConfig {
  id           String   @id @default(cuid())
  key          String   @unique
  name         String
  priceKES     Int
  durationDays Int
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  subscriptions Subscription[]
}

model Subscription {
  id         String             @id @default(cuid())
  businessId String             @unique
  business   Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String
  user       User               @relation(fields: [userId], references: [id])
  planId     String
  plan       PlanConfig         @relation(fields: [planId], references: [id])
  status     SubscriptionStatus @default(PENDING)
  startAt    DateTime?
  expiresAt  DateTime?
  graceUntil DateTime?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@index([userId])
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRING
  EXPIRED
  SUSPENDED
  CANCELLED
}

model Payment {
  id         String        @id @default(cuid())
  reference  String        @unique
  businessId String?
  business   Business?     @relation(fields: [businessId], references: [id])
  userId     String
  user       User          @relation(fields: [userId], references: [id])
  planId     String?
  amount     Int
  currency   String        @default("KES")
  status     PaymentStatus @default(PENDING)
  paystackId String?
  raw        String?       @db.Text
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  // Interactive Business: one payment stack, many purposes (§25 reuses Paystack).
  // SUBSCRIPTION | ORDER | BOOKING_DEPOSIT
  purpose    String        @default("SUBSCRIPTION")
  orderId    String?
  order      Order?        @relation(fields: [orderId], references: [id])
  bookingId  String?
  customerEmail String?    // Guest checkout payer — never a secret (§47)

  @@index([userId])
  @@index([businessId])
  @@index([orderId])
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  EXPIRED
  CANCELLED
}

model AuditEvent {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String
  targetType String?
  targetId   String?
  metadata   String?  @db.Text
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([action])
}

model ProcessedWebhook {
  id        String   @id
  createdAt DateTime @default(now())
}

// ── Stage 2: self-service referral attribution ──
// One row per referral touch. PENDING = anonymous attribution created when a recipient opens a
// referral link; CONVERTED = the recipient registered and created their first business in the
// same transaction; REJECTED/EXPIRED = the touch was ineligible or lapsed.
// No foreign keys by design: the migration stays purely additive, no cascade can delete an
// attribution record, and only opaque ids (never email/phone/IP) are stored.

enum ReferralStatus {
  PENDING
  CONVERTED
  REJECTED
  EXPIRED
}

model Referral {
  id                 String         @id @default(cuid())
  code               String
  referrerUserId     String
  referrerBusinessId String?
  // Unique: a referred user is only ever attributed once (first-touch wins at the DB level).
  referredUserId     String?        @unique
  referredBusinessId String?
  status             ReferralStatus @default(PENDING)
  // SHA-256 of the token held in the recipient's httpOnly cookie. The raw token is never stored.
  tokenHash          String         @unique
  rejectReason       String?
  createdAt          DateTime       @default(now())
  expiresAt          DateTime
  convertedAt        DateTime?

  @@index([code, status])
  @@index([referrerUserId, status])
  @@index([status, createdAt])
}

// ── AI Business Front Desk (§3, §6, §7, §9, §49) ──
// Multi-tenant AI package: isolated business brain, AI config, products with inventory,
// merchant payment credentials (encrypted refs only), and package entitlement.

model AIConfiguration {
  id                 String     @id @default(cuid())
  businessId         String     @unique
  business           Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  tone               String     @default("friendly") // professional | friendly | casual | premium | local | formal
  language           String     @default("en") // en | sw | sheng | mixed
  salesBehavior      String     @default("informational") // informational | recommend | upsell | cross_sell | promotions
  orderingAllowed    Boolean    @default(true)
  preordersAllowed   Boolean    @default(false)
  humanEscalation    String     @default("uncertain") // always | business_hours | specified_topics | uncertain
  welcomeMessage     String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
}

model Product {
  id                 String     @id @default(cuid())
  businessId         String
  business           Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name               String
  description        String?    @db.Text
  sku                String?
  category           String?
  basePriceKES       Int?
  variantPriceKES    Int?
  currency           String     @default("KES")
  stockStatus        StockStatus @default(IN_STOCK)
  quantity           Int?
  minOrder           Int       @default(1)
  maxOrder           Int?
  preOrderAllowed    Boolean    @default(false)
  deliveryEligible   Boolean    @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // ── Interactive Business catalogue fields (§7–§10, §17) ──
  // Category-shaped, all optional: the experience profile decides which are shown.
  salePriceKES       Int?       // Display/strike-through price; `basePriceKES` stays authoritative.
  imageUrl           String?    @db.Text
  images             String?    @db.Text   // JSON array of media urls (gallery)
  brand              String?
  portionSize        String?    // Food: "Full plate", Cosmetics: "50ml"
  ingredients        String?    @db.Text
  prepMinutes        Int?       // Food: preparation time
  tags               String?    // JSON array of strings
  addOns             String?    @db.Text   // JSON [{ id, name, priceKES }]
  variantOptions     String?    @db.Text   // JSON { "Size": ["S","M"], "Colour": ["Red"] }
  isFeatured         Boolean    @default(false)
  isActive           Boolean    @default(true)
  sortOrder          Int        @default(0)
  variants           ProductVariant[]

  @@index([businessId])
  @@index([businessId, category])
}

//
// A sellable variant of a product (e.g. "Red / M"). Pricing stays server-authoritative:
// the checkout engine loads the variant by id inside the tenant and uses its price
// override (falling back to the product price). Never trust a client price. (§26)
//
model ProductVariant {
  id         String     @id @default(cuid())
  businessId String
  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  productId  String
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  label      String                        // "Red / M"
  options    String?    @db.Text           // JSON { "Colour": "Red", "Size": "M" }
  priceKES   Int?                          // Override; null = use product price
  sku        String?
  stockStatus StockStatus @default(IN_STOCK)
  sortOrder  Int        @default(0)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([businessId])
  @@index([productId])
}

enum StockStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
  PRE_ORDER
  DISCONTINUED
  AVAILABLE_ON_REQUEST
}

model KnowledgeDocument {
  id                 String     @id @default(cuid())
  businessId         String
  business           Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  title              String
  content            String     @db.Text
  sourceType         String     // manual | csv_import | document_upload | website_import
  isApproved         Boolean    @default(false)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@index([businessId])
}

model FAQ {
  id                 String     @id @default(cuid())
  businessId         String
  business           Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  question           String
  approvedAnswer     String     @db.Text
  isActive           Boolean    @default(true)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@index([businessId])
}

// Package entitlement: explicit link between a business and the AI Front Desk package.
// Not a replacement for Subscription; a business must have both an ACTIVE subscription
// to the package key AND a verified PAID payment before the AI package is live.
model AIPackageEntitlement {
  id                 String     @id @default(cuid())
  businessId         String     @unique
  business           Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  packageKey         String     @default("AI_BUSINESS_FRONT_DESK")
  status             String     @default("PENDING") // PENDING | ACTIVE | SUSPENDED | EXPIRED
  activatedAt        DateTime?
  expiresAt          DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@index([businessId])
}

// ── Phase 3 Commerce (§12–§15, §30–§34, §51, §67, §76–§77, §89–§90) ──
// Multi-tenant commerce: cart, orders, inventory reservation, pricing engine,
// merchant payment configuration (business's own destination, never substituted),
// pre-orders, and deterministic server-side calculation.

model Cart {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId String?  // Optional; can be anonymous session reference
  items      CartItem[]
  status     String   @default("ACTIVE") // ACTIVE | CONVERTED | ABANDONED
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([businessId])
  @@index([customerId])
}

model CartItem {
  id         String   @id @default(cuid())
  cartId     String
  cart       Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId  String?
  serviceId  String?
  variantDesc String? // Size, colour, etc.
  quantity   Int      @default(1)
  unitPriceKES Int?   // Authoritative price at time of cart creation (§11, §33)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([cartId])
}

model Order {
  id              String         @id @default(cuid())
  orderReference  String         @unique // Example: JATA-ORD-20261001-...
  businessId      String
  business        Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId      String?
  customerName    String?
  customerPhone   String?
  customerEmail   String?
  deliveryLocation String?
  deliveryInstructions String?
  status          OrderStatus    @default(DRAFT)
  subtotalKES     Int            @default(0)
  deliveryFeeKES  Int            @default(0)
  discountKES     Int            @default(0)
  totalKES        Int            @default(0)
  currency        String         @default("KES")
  preOrder        Boolean        @default(false)
  items           OrderItem[]
  payments        Payment[]     // Related to this order; server-side verified only (§14, §35)
  preOrders       PreOrder[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  completedAt     DateTime?

  // ── Interactive Business checkout (§25, §27) ──
  fulfilmentType  String?       // PICKUP | DELIVERY
  notes           String?       @db.Text
  source          String?       @default("STOREFRONT")
  // UNPAID | PAID — an unpaid order is never treated as a sale (§27).
  paymentStatus   String        @default("UNPAID")

  @@index([businessId])
  @@index([status])
  @@index([customerId])
  @@index([businessId, createdAt])
}

enum OrderStatus {
  DRAFT
  PENDING_CUSTOMER_CONFIRMATION
  PENDING_PAYMENT
  PAYMENT_PROCESSING
  PAYMENT_VERIFIED
  CONFIRMED
  PROCESSING
  READY
  OUT_FOR_DELIVERY
  COMPLETED
  CANCELLED
  REFUNDED
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String?
  serviceId  String?
  name       String   // Authoritative name at order time
  variantDesc String?
  quantity   Int      @default(1)
  unitPriceKES Int    // Authoritative price (§11, §33)
  createdAt  DateTime @default(now())
  // Interactive Business: chosen variant + add-ons, captured for fulfilment clarity.
  variantId  String?
  addOns     String?  @db.Text   // JSON [{ id, name, priceKES }]
  imageUrl   String?  @db.Text

  @@index([orderId])
}

// Pre-order support (§15) — separate from immediate orders.
model PreOrder {
  id             String   @id @default(cuid())
  businessId     String
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId     String?
  customerName   String?
  customerPhone  String?
  productId      String
  productName    String
  variantDesc    String?
  quantity       Int      @default(1)
  depositRequiredKES Int?  // Configured deposit (§15)
  fullPriceKES   Int?
  status         PreOrderStatus @default(PENDING)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  orders Order[]

  @@index([businessId])
  @@index([status])
}

enum PreOrderStatus {
  PENDING
  DEPOSIT_PAID
  FULL_PAYMENT_PAID
  READY_TO_FULFILL
  COMPLETED
  CANCELLED
  REFUNDED
}

// Merchant payment configuration (§6, §49) — the business's own payment destination.
// Never substitutes JATA's destination. Never stores secret API keys in plaintext.
model MerchantPaymentConfig {
  id              String   @id @default(cuid())
  businessId      String   @unique
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // Public payment information (displayed to customers, safe for AI prompts)
  publicInfo      String   @db.Text // Example: "M-Pesa: Buy Goods 12345678"
  // Private API credentials are encrypted at rest and never exposed to AI or browser (§6, §43)
  encryptedCredentials String? @db.Text // Encrypted payload (gateway OAuth tokens, etc.)
  credentialRotationNote String? // Audit note without recording secrets (§47)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([businessId])
}

// ── Phase 4 Notifications (§17, §18, §37, §63) ──
// Multi-tenant notification system with nominated business number,
// transaction notification, reliability tracking, and audit events.

model Notification {
  id              String     @id @default(cuid())
  businessId      String
  business        Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  eventType       String     // NEW_ORDER | PREORDER | BOOKING | HUMAN_HANDOFF | PAYMENT_VERIFIED | LOW_STOCK | OUT_OF_STOCK | FAILED_NOTIFICATION
  title           String
  message         String     @db.Text
  channel         String     @default("WHATSAPP") // WHATSAPP | SMS | EMAIL | IN_APP
  recipientNumber String?
  recipientEmail  String?
  status          NotificationStatus @default(PENDING)
  deliveryAttempted Boolean  @default(false)
  deliveryFailed  Boolean    @default(false)
  retryCount      Int        @default(0)
  maxRetries      Int        @default(3)
  referenceId     String?    // Links to Order, PreOrder, or other entity
  createdAt       DateTime   @default(now())
  deliveredAt     DateTime?

  @@index([businessId])
  @@index([status])
  @@index([businessId, eventType])
}

enum NotificationStatus {
  PENDING
  QUEUED
  DELIVERED
  FAILED
  RETRY_QUEUED
  SKIPPED
}

model NotificationRecipient {
  id              String     @id @default(cuid())
  businessId      String
  business        Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  label           String     // PRIMARY | SECONDARY | STAFF | OWNER
  phone           String?
  email           String?
  whatsappEnabled Boolean    @default(true)
  smsEnabled      Boolean    @default(true)
  emailEnabled    Boolean    @default(true)
  isActive        Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([businessId])
  @@unique([businessId, label])
}

// ── Phase 5 Intelligence (§28, §29, §30, §54, §64, §65) ──
// Intelligence panel: unanswered questions, missed-demand tracking,
// AI quality tracking (source, confidence, escalation), and readiness enhancement.

model UnansweredQuestion {
  id              String     @id @default(cuid())
  businessId      String
  business        Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  question        String     @db.Text
  askedCount      Int        @default(1) // How many times asked
  firstAskedAt    DateTime   @default(now())
  lastAskedAt     DateTime   @updatedAt
  approvedAnswer  String?    @db.Text // Once owner approves an answer (§29)
  isResolved      Boolean    @default(false)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([businessId])
  @@index([isResolved])
  @@index([question])
}

model DemandInsight {
  id              String     @id @default(cuid())
  businessId      String
  business        Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  insightType     String     // MISSED_DEMAND | UNAVAILABLE_PRODUCT | OUT_OF_ZONE | SERVICE_NOT_OFFERED | PRICE_INQUIRY
  subject         String     // What was requested (e.g., product name, service, delivery zone)
  count           Int        @default(1)
  firstRecorded   DateTime   @default(now())
  lastRecorded    DateTime   @updatedAt
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([businessId])
  @@index([insightType])
}

model AIQualityEvent {
  id              String     @id @default(cuid())
  businessId      String
  business        Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  conversationId  String?
  sourceUsed      String     // structured_data | faq | knowledge_document | unknown
  confidence      String?    // high | low | uncertain
  escalatedToHuman Boolean  @default(false)
  customerCorrectedAI Boolean @default(false)
  missingBusinessInfo Boolean @default(false)
  eventType       String?    // QUESTION | ORDER | BOOKING | HANDOFF
  timestamp       DateTime   @default(now())
  metadata        String?    @db.Text // Safe JSON, no secrets (§30, §43)

  @@index([businessId])
  @@index([eventType])
  @@index([sourceUsed])
}

// ── JATA Interactive Business (§6, §14–§16, §38, §51, §58, §59) ──
// Category-aware, multi-tenant business experience platform.
//
// Architecture (§51): Business + Category + ExperienceProfile + Theme + Sections + Data
// + enabled features. There are no per-category applications and no template lock-in:
// one renderer consumes one normalized experience document.

//
// The versioned website document for one tenant.
//
// DRAFT and PUBLISHED are strictly separated (§15): the owner edits `draftJson`, customers
// only ever read `publishedJson`. Publishing copies the draft into `publishedJson`, bumps
// `publishedVersion` and snapshots it in ExperienceVersion so a future rollback is possible.
//
model BusinessExperience {
  id               String   @id @default(cuid())
  businessId       String   @unique
  business         Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  categoryKey      String   @default("other")
  themeKey         String   @default("core-minimal")
  status           String   @default("DRAFT")      // DRAFT | PUBLISHED | UNPUBLISHED
  draftJson        String   @db.Text
  publishedJson    String?  @db.Text
  draftVersion     Int      @default(1)
  // Which draft revision the current draft equals, so Undo/Redo can move one step at a time (§45).
  // 0 means "not tracked yet" (legacy rows and freshly created sites); it is then treated as the
  // newest revision, which is exactly what an owner who has never pressed Undo expects.
  historyCursor    Int      @default(0)
  publishedVersion Int      @default(0)
  publishedAt      DateTime?
  publishedById    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([businessId])
  @@index([businessId, status])
}

// Immutable publication snapshot — enables rollback and an audit trail (§15, §46).
model ExperienceVersion {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  version     Int
  themeKey    String
  categoryKey String
  snapshotJson String  @db.Text
  publishedAt DateTime @default(now())
  publishedById String?
  note        String?

  @@unique([businessId, version])
  @@index([businessId, publishedAt])
}

// Draft revision history — Undo, Redo and recovery for everything the owner changes (§15, §45).
//
// Every write to the draft — a section, a design change, a photo swap, a product edit, AI copy —
// goes through the one Studio write path, which records the document it produced here. Undo and
// Redo therefore work for every kind of change with one mechanism, and no owner work is ever
// unrecoverable. Rows are bounded: the write path prunes to the newest DRAFT_HISTORY_LIMIT
// revisions, so storage stays small and predictable.
model ExperienceDraftRevision {
  id           String   @id @default(cuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // Mirrors BusinessExperience.draftVersion, so a revision and a draft number never disagree.
  draftVersion Int
  label        String?
  // EDIT | AI | RESTORE | SYSTEM
  source       String   @default("EDIT")
  snapshotJson String   @db.Text
  createdById  String?
  createdAt    DateTime @default(now())

  @@unique([businessId, draftVersion])
  @@index([businessId, createdAt])
}

//
// Entitlement for the Interactive Business package (§59).
// Deliberately separate from Subscription: a business needs BOTH a valid subscription
// to the INTERACTIVE_BUSINESS plan AND a verified PAID payment, exactly like the
// existing publish gate (§3). Expiry never deletes content (§59).
//
model InteractiveBusinessEntitlement {
  id          String   @id @default(cuid())
  businessId  String   @unique
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  packageKey  String   @default("INTERACTIVE_BUSINESS")
  status      String   @default("PENDING")   // PENDING | ACTIVE | PAST_DUE | EXPIRED | CANCELLED
  activatedAt DateTime?
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([businessId])
  @@index([status])
}

//
// Tenant media library (§19). `hash` deduplicates identical uploads so the same asset is
// never stored twice for one business. Alt text is stored with the asset so accessibility
// travels with the image (§48).
//
model MediaAsset {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  url        String   @db.Text
  kind       String   @default("IMAGE")   // IMAGE | LOGO | HERO | OTHER
  alt        String?
  width      Int?
  height     Int?
  bytes      Int?
  hash       String?
  mime       String?
  // Where the pixels came from (§18, §43). Provenance travels with the asset so the Studio can
  // always answer "did the owner photograph this, or did JATA make it?".
  source     String   @default("UPLOAD")  // UPLOAD | AI_GENERATED | AI_ENHANCED | ENHANCED
  // What the image may claim to be (§15): ACTUAL = the real product, REPRESENTATIVE = designed
  // artwork standing in for a photo the business does not have, AI_GENERATED = vendor photo.
  label      String?
  aiGenerationId String?
  parentAssetId  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([businessId])
  @@index([businessId, hash])
  @@index([businessId, createdAt])
  @@index([businessId, source])
  @@index([businessId, kind])
}

// AI generation history and usage meter (§17, §43, §51).
//
// One row per request, whatever the outcome: what was asked, for whom, which provider and
// model, how long it took and which media assets it produced. The image allowance is counted
// from these rows, so the meter and the audit trail can never disagree, and deleting a
// generation removes exactly the assets it created.
model AiGeneration {
  id             String   @id @default(cuid())
  businessId     String
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId         String?
  kind           String                        // IMAGE | ENHANCE | COPY | ALT_TEXT
  capability     String?                       // preset key, e.g. "product-photo"
  subjectType    String?                       // PRODUCT | SERVICE | SECTION | BUSINESS
  subjectId      String?
  prompt         String?  @db.Text
  promptHash     String?
  providerKey    String   @default("jata-local")
  modelKey       String?
  status         String   @default("PENDING")  // PENDING | SUCCEEDED | FAILED | BLOCKED
  errorCode      String?
  assetIds       String?  @db.Text
  selectedAssetId String?
  durationMs     Int?
  createdAt      DateTime @default(now())
  completedAt    DateTime?

  @@index([businessId, createdAt])
  @@index([businessId, status])
  @@index([businessId, promptHash])
  @@index([businessId, kind, status])
}

// ══════════════════════════════════════════════════════════════════════════════
// JATA AFTERCALL — Configurable Business POS (spec §1–§81)
//
// ONE engine, many operating models (§76). Every model below is tenant-scoped by
// `businessId` and indexed on it, so isolation is enforced in the data model as well as in
// the access layer (§5). There is no per-industry table: a garage's vehicle, an estate
// agent's unit and a school's locker are all `PosCustomerAsset`, and a restaurant's order,
// a laundry's load and a courier's shipment are all `PosOrder` in a configured workflow
// (§29, §52). What differs between businesses is configuration, not schema.
//
// Money is stored as whole Kenyan shillings (§31, §54). Transactions are never rewritten:
// corrections are returns, refunds, adjustments or reversals with their own rows (§54).
// ══════════════════════════════════════════════════════════════════════════════

//
// The Business Operating Profile (§7, §20). `draftJson` is what the owner is editing;
// `publishedJson` is what the live POS executes. Publishing snapshots the draft into
// PosConfigurationVersion so history stays interpretable when the business changes (§48).
//
model PosConfiguration {
  id                  String    @id @default(cuid())
  businessId          String    @unique
  business            Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // DRAFT | CONFIGURED | PREVIEW | AWAITING_PAYMENT | PAYMENT_CONFIRMED | PROVISIONING |
  // LIVE | SUSPENDED | CANCELLED (§44)
  status              String    @default("DRAFT")
  // INCOMPLETE | READY | PUBLISHED — the configuration's own completeness (§42)
  configurationStatus String    @default("INCOMPLETE")
  businessTypeKey     String    @default("other")
  answersJson         String    @db.Text
  draftJson           String    @db.Text
  publishedJson       String?   @db.Text
  draftVersion        Int       @default(1)
  publishedVersion    Int       @default(0)
  // Stable hash of the material configuration, used to decide when a version is deserved (§48)
  fingerprint         String?
  publishedAt         DateTime?
  publishedById       String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  versions            PosConfigurationVersion[]

  @@index([businessId, status])
}

// Immutable configuration snapshots (§48). Rollback writes a new version; it never edits one.
model PosConfigurationVersion {
  id           String           @id @default(cuid())
  businessId   String
  business     Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  configuration PosConfiguration @relation(fields: [configurationId], references: [id], onDelete: Cascade)
  configurationId String
  version      Int
  snapshotJson String           @db.Text
  answersJson  String           @db.Text
  fingerprint  String?
  note         String?
  createdById  String?
  publishedAt  DateTime         @default(now())

  @@unique([businessId, version])
  @@index([businessId, publishedAt])
}

//
// The Business POS subscription (§45). Deliberately separate from `Subscription`: a business
// may hold its AFTERCALL plan and the POS product at the same time, and paying for one must
// never disturb the other (§4, §80).
//
model PosSubscription {
  id               String    @id @default(cuid())
  businessId       String    @unique
  business         Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId           String
  planId           String
  planKey          String    @default("BUSINESS_POS")
  // PENDING | ACTIVE | EXPIRING | PAST_DUE | EXPIRED | SUSPENDED | CANCELLED
  status           String    @default("PENDING")
  startAt          DateTime?
  expiresAt        DateTime?
  graceUntil       DateTime?
  paymentId        String?
  paymentReference String?
  cancelledAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([businessId, status])
  @@index([userId])
}

// Persisted entitlement so admin views and lifecycle jobs can query state directly (§44).
model PosEntitlement {
  id          String    @id @default(cuid())
  businessId  String    @unique
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  packageKey  String    @default("BUSINESS_POS")
  status      String    @default("NONE")
  activatedAt DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([businessId, status])
}

// Saved configurations — "my business template" (§26) and the source of a clone (§25, §50).
// Structure only: no balances, transactions or credentials are ever stored here.
model PosTemplate {
  id                String    @id @default(cuid())
  ownerId           String
  businessId        String?
  business          Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  key               String
  name              String
  description       String?
  businessTypeKey   String    @default("other")
  configurationJson String    @db.Text
  answersJson       String    @db.Text
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([ownerId])
  @@index([businessId])
}

// Locations (§16). One branch row exists even for a single-location business so stock and
// sales always have a home.
model PosBranch {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  code       String?
  location   String?
  phone      String?
  isPrimary  Boolean  @default(false)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([businessId, name])
  @@index([businessId])
}

//
// People who operate the POS (§15, §36). A staff record may exist before it has a platform
// login, so `userId` is nullable and intentionally not a foreign key: staff are business
// records first, platform users only once invited.
//
model PosStaff {
  id                String    @id @default(cuid())
  businessId        String
  business          Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId            String?
  name              String
  phone             String?
  email             String?
  roleKey           String    @default("CASHIER")
  branchId          String?
  commissionPercent Int       @default(0)
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([businessId, roleKey])
  @@index([businessId, userId])
}

// Products and services (§8, §13). One table, configured fields: a restaurant dish, a
// hardware item and a salon treatment differ by `kind`, unit and which columns the
// configuration exposes (§24 — forms only ask for relevant fields).
model PosProduct {
  id                String    @id @default(cuid())
  businessId        String
  business          Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name              String
  kind              String    @default("PRODUCT")   // PRODUCT | SERVICE
  category          String?
  description       String?   @db.Text
  unitKey           String    @default("piece")
  priceKES          Int       @default(0)
  wholesalePriceKES Int?
  costKES           Int?
  sku               String?
  barcode           String?
  trackInventory    Boolean   @default(true)
  reorderLevel      Int       @default(0)
  taxable           Boolean   @default(false)
  durationMinutes   Int?
  variantOptions    String?   @db.Text   // JSON: { "Size": ["S","M"], "Colour": ["Red"] }
  imageUrl          String?   @db.Text
  isActive          Boolean   @default(true)
  sortOrder         Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  inventory         PosInventoryItem[]
  movements         PosInventoryMovement[]

  @@index([businessId, kind])
  @@index([businessId, name])
  @@index([businessId, barcode])
}

// Stock on hand per product and location (§16, §33). Never edited directly: the number is
// the sum of PosInventoryMovement rows.
model PosInventoryItem {
  id           String     @id @default(cuid())
  businessId   String
  business     Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  productId    String
  product      PosProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  // Empty string means "the business's own stock room". A nullable column would make the
  // unique pair below meaningless in Postgres, where NULLs never collide (§16, §33).
  branchId     String     @default("")
  // Float: measurable units (kilogram, litre, metre) carry up to three decimal places (§13, §14);
  // countable units are still stored whole. Never edited directly: the number is the sum of
  // PosInventoryMovement rows.
  quantity     Float      @default(0)
  reorderLevel Int        @default(0)
  updatedAt    DateTime   @updatedAt
  createdAt    DateTime   @default(now())

  @@unique([productId, branchId])
  @@index([businessId])
  @@index([businessId, branchId])
}

// The stock ledger (§33): every change has a reason, an actor and a reference.
model PosInventoryMovement {
  id          String     @id @default(cuid())
  businessId  String
  business    Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  productId   String
  product     PosProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  branchId    String?
  reason      String     // SALE | RETURN | PURCHASE | ADJUSTMENT | DAMAGE | COUNT | TRANSFER_IN …
  delta       Float      // signed change in base units (three-decimal precision, §13)
  quantity    Float      @default(0)
  unitKey     String?
  refType     String?    // SALE | PURCHASE | ADJUSTMENT | TRANSFER
  refId       String?
  note        String?    @db.Text
  createdById String?
  createdAt   DateTime   @default(now())

  @@index([businessId, productId, createdAt])
  @@index([businessId, reason])
  @@index([businessId, branchId])
}

// Customers (§14, §46). The structure is identical for every trade; only the label changes.
model PosCustomer {
  id             String   @id @default(cuid())
  businessId     String
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name           String
  phone          String?
  email          String?
  location       String?
  customerNumber String?
  segment        String?
  notes          String?  @db.Text
  creditEnabled  Boolean  @default(false)
  creditLimitKES Int      @default(0)
  // Denormalized running balance, always written together with a PosCreditEntry (§30).
  balanceKES     Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  assets         PosCustomerAsset[]

  @@index([businessId, name])
  @@index([businessId, phone])
  @@index([businessId, creditEnabled])
}

//
// Something a customer owns or occupies: a vehicle and registration number for a garage, a
// property unit for an agent, a pet for a vet (§18). One generic model instead of a table
// per trade (§52).
//
model PosCustomerAsset {
  id          String      @id @default(cuid())
  businessId  String
  business    Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId  String
  customer    PosCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label       String      // "Vehicle", "Unit", "Pet" — set from terminology
  name        String
  identifier  String?     // registration number, unit number, tag
  detailsJson String?     @db.Text
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([businessId, customerId])
  @@index([businessId, identifier])
}

// Suppliers (§12, §30). Supplier credit is a separate ledger from customer credit.
model PosSupplier {
  id           String   @id @default(cuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name         String
  phone        String?
  email        String?
  location     String?
  termsDays    Int      @default(0)
  creditEnabled Boolean @default(false)
  balanceKES   Int      @default(0)
  notes        String?  @db.Text
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([businessId, name])
}

// Sales (§27, §31, §54). Immutable once completed: corrections create new rows.
model PosSale {
  id                     String    @id @default(cuid())
  businessId             String
  business               Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId               String?
  receiptNumber          String
  sequence               Int       @default(1)
  customerId             String?
  customerName           String?
  staffId                String?
  staffName              String?
  // Attribution source (§28, §70), stored with the engine's ChannelKey spelling:
  // walk_in | phone | whatsapp | business_page | online | staff | delivery | other
  channel                String    @default("walk_in")
  // COMPLETED | PARTIALLY_PAID | REFUNDED | PARTIALLY_REFUNDED | VOIDED
  status                 String    @default("COMPLETED")
  kind                   String    @default("SALE")   // SALE | QUOTATION | INVOICE
  subtotalKES            Int       @default(0)
  discountKES            Int       @default(0)
  taxKES                 Int        @default(0)
  feeKES                 Int       @default(0)
  totalKES               Int       @default(0)
  paidKES                Int       @default(0)
  balanceKES             Int       @default(0)
  refundedKES            Int       @default(0)
  // Of `refundedKES`, the part already applied against the customer's receivable (a credit refund
  // never produces cash). The remainder of `refundedKES` is cash that left the till (§30, §54).
  creditRefundedKES      Int       @default(0)
  costKES                Int?
  notes                  String?   @db.Text
  // Which configuration produced this transaction, so it stays interpretable later (§48)
  configurationVersion   Int       @default(1)
  configurationFingerprint String?
  createdAt              DateTime  @default(now())
  completedAt            DateTime?
  items                  PosSaleItem[]
  payments               PosPayment[]

  @@unique([businessId, receiptNumber])
  @@index([businessId, createdAt])
  @@index([businessId, status])
  @@index([businessId, customerId])
  @@index([businessId, branchId, createdAt])
  paymentTransactions PaymentTransaction[]
}

//
// The per-business receipt sequence (§32). The single allocation point for sale receipt
// numbers: a sale transaction claims its number with one atomic upsert, so concurrent sales
// always receive unique sequences and no sale fails because another chose the same number.
// No relation by design — like the stock room, the table is tenant-scoped by `businessId`
// (unique), and a plain column keeps the back-relation surface of `Business` unchanged.
model PosReceiptSequence {
  businessId String @unique
  nextValue  Int    @default(1)

  @@index([businessId])
}

model PosSaleItem {
  id           String   @id @default(cuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  saleId       String
  sale         PosSale  @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId    String?
  // Authoritative name, unit and price at the moment of sale (§54)
  name         String
  kind         String   @default("PRODUCT")
  unitKey      String?
  // Float: measurable units (kilogram, litre, metre) carry up to three decimal places (§13, §14).
  quantity     Float      @default(1)
  // How much of this line has already been returned. A line may only ever be returned up to its
  // quantity; the check is enforced atomically against this column (§54).
  returnedQty  Float      @default(0)
  unitPriceKES Int      @default(0)
  discountKES  Int      @default(0)
  taxKES       Int      @default(0)
  totalKES     Int      @default(0)
  costKES      Int?
  variantDesc  String?
  createdAt    DateTime @default(now())

  @@index([saleId])
  @@index([businessId, productId])
}

//
// Money movement inside the POS (§31). Separate from the platform `Payment` model, which
// records what customers pay *JATA*; this records what customers pay *the business*.
//
model PosPayment {
  id          String    @id @default(cuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  saleId      String?
  sale        PosSale?  @relation(fields: [saleId], references: [id], onDelete: Cascade)
  customerId  String?
  supplierId  String?
  branchId    String?
  // IN | OUT
  direction   String    @default("IN")
  // SALE | CREDIT_REPAYMENT | SUPPLIER_PAYMENT | EXPENSE | DEPOSIT | REFUND
  purpose     String    @default("SALE")
  method      String    @default("cash")
  amountKES   Int       @default(0)
  reference   String?
  // SETTLED | PENDING | REVERSED | FAILED
  status      String    @default("SETTLED")
  notes       String?   @db.Text
  createdById String?
  createdAt   DateTime  @default(now())

  @@index([businessId, createdAt])
  @@index([businessId, purpose])
  @@index([saleId])
  @@index([businessId, customerId])
  @@index([businessId, supplierId])
}

// Credit ledger (§30). `partyType` keeps receivables and payables permanently separate.
model PosCreditEntry {
  id              String    @id @default(cuid())
  businessId      String
  business        Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  partyType       String    @default("CUSTOMER")   // CUSTOMER | SUPPLIER
  partyId         String
  partyName       String?
  direction       String    @default("DEBIT")      // DEBIT (owed) | CREDIT (paid)
  amountKES       Int       @default(0)
  balanceAfterKES Int       @default(0)
  dueAt           DateTime?
  saleId          String?
  paymentId       String?
  note            String?   @db.Text
  createdById     String?
  createdAt       DateTime  @default(now())

  @@index([businessId, partyType, partyId])
  @@index([businessId, dueAt])
  @@index([businessId, createdAt])
}

// Expenses (§17). Categories come from the configuration, including custom ones.
model PosExpense {
  id          String    @id @default(cuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId    String?
  categoryKey String
  label       String?
  amountKES   Int       @default(0)
  method      String    @default("cash")
  reference   String?
  occurredAt  DateTime  @default(now())
  notes       String?   @db.Text
  createdById String?
  createdAt   DateTime  @default(now())

  @@index([businessId, occurredAt])
  @@index([businessId, categoryKey])
}

// Purchases and purchase orders (§12, §33). Receiving writes stock movements.
model PosPurchase {
  id          String    @id @default(cuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  supplierId  String?
  branchId    String?
  reference   String
  // DRAFT | ORDERED | PARTIAL | RECEIVED | CANCELLED
  status      String    @default("ORDERED")
  subtotalKES Int       @default(0)
  totalKES    Int       @default(0)
  paidKES     Int       @default(0)
  expectedAt  DateTime?
  receivedAt  DateTime?
  notes       String?   @db.Text
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  items       PosPurchaseItem[]

  @@unique([businessId, reference])
  @@index([businessId, status])
  @@index([businessId, supplierId])
}

model PosPurchaseItem {
  id           String    @id @default(cuid())
  businessId   String
  business     Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  purchaseId   String
  purchase     PosPurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId    String?
  name         String
  unitKey      String?
  quantity     Float       @default(1)
  receivedQty  Float       @default(0)
  unitCostKES  Int       @default(0)
  totalKES     Int       @default(0)
  createdAt    DateTime  @default(now())

  @@index([purchaseId])
  @@index([businessId, productId])
}

//
// Orders (§28, §29). One table, configurable states: a restaurant ticket, a laundry load, a
// courier shipment and a garage job all live here and move through the workflow their
// configuration chose. Channel metadata is recorded for attribution reporting (§70).
//
model PosOrder {
  id           String    @id @default(cuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId     String?
  reference    String
  customerId   String?
  customerName String?
  customerPhone String?
  staffId      String?
  assignedToId String?
  channel      String    @default("walk_in")   // see PosSale.channel (§70)
  workflowKey  String    @default("generic")
  stateKey     String    @default("NEW")
  fulfilment   String?   // DELIVERY | PICKUP | DINE_IN
  address      String?
  subtotalKES  Int       @default(0)
  totalKES     Int       @default(0)
  depositKES   Int       @default(0)
  expectedAt   DateTime?
  saleId       String?
  notes        String?   @db.Text
  createdById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  items        PosOrderItem[]
  events       PosOrderEvent[]

  @@unique([businessId, reference])
  @@index([businessId, stateKey])
  @@index([businessId, createdAt])
  @@index([businessId, channel])
}

model PosOrderItem {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orderId     String
  order       PosOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  name        String
  quantity    Float      @default(1)
  unitKey     String?
  unitPriceKES Int     @default(0)
  totalKES    Int      @default(0)
  modifiers   String?  @db.Text   // JSON: extras, notes to the kitchen
  createdAt   DateTime @default(now())

  @@index([orderId])
  @@index([businessId])
}

// Order state history — the workflow engine's audit trail (§29).
model PosOrderEvent {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orderId     String
  order       PosOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromState   String?
  toState     String
  note        String?
  createdById String?
  createdAt   DateTime @default(now())

  @@index([orderId])
  @@index([businessId, createdAt])
}

// POS audit log (§37). Tenant-scoped, unlike the platform-wide AuditEvent.
model PosAuditEvent {
  id         String    @id @default(cuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  actorId    String?
  actorName  String?
  action     String
  targetType String?
  targetId   String?
  branchId   String?
  metadata   String?   @db.Text
  createdAt  DateTime  @default(now())

  @@index([businessId, createdAt])
  @@index([businessId, action])
}

// ══════════════════════════════════════════════════════════════════════════════
// JATA PAYMENT WALLET + JATA PAYMENT ORCHESTRATION (§4, §6, §75)
//
// The merchant's payment destination, the provider connection JATA operates on the
// merchant's behalf, the payment transaction and its full evidentiary trail: attempts,
// provider events, notifications, refunds, reconciliation and audit.
//
// Every row is tenant-owned (businessId), money is stored in integer minor units (§77)
// and financial rows are never rewritten — corrections are new rows (§114).
// ══════════════════════════════════════════════════════════════════════════════

/// Which provider the destination (and every payment routed to it) belongs to.
enum PaymentProviderKey {
  MPESA
  PAYSTACK
  BANK
  AIRTEL_MONEY
}

/// What the merchant entered — the only thing JATA asks them for (§9, §10).
enum PaymentDestinationKind {
  MPESA_TILL
  MPESA_PAYBILL
  MPESA_POCHI
  BANK_ACCOUNT
  PAYSTACK
}

/// How far the destination has actually been verified (§52). Never call a destination
/// "connected" because its number has the right length.
enum PaymentDestinationStatus {
  UNVERIFIED
  FORMAT_VERIFIED
  PROVIDER_VERIFIED
  CONNECTED
  ACTION_REQUIRED
  UNAVAILABLE
  DISCONNECTED
}

/// The financial lifecycle (§31). Never collapsed into a boolean.
enum PaymentTransactionStatus {
  CREATED
  PAYMENT_REQUESTED
  PENDING
  PROCESSING
  CONFIRMED
  PAID
  FAILED
  EXPIRED
  CANCELLED
  REVERSED
  PARTIALLY_PAID
  PARTIALLY_REFUNDED
  FULLY_REFUNDED
}

enum PaymentEventStatus {
  RECEIVED
  PROCESSED
  DUPLICATE
  REJECTED
  FAILED
}

enum PaymentAttemptStatus {
  REQUESTED
  ACCEPTED
  REJECTED
  FAILED
  TIMEOUT
}

enum PaymentNotificationStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum PaymentNotificationAudience {
  MERCHANT
  CUSTOMER
}

enum PaymentReconciliationResult {
  MATCHED
  AMOUNT_MISMATCH
  UNKNOWN_PAYMENT
  DUPLICATE
  UNCONFIRMED
  MANUAL_MATCHED
}

enum RefundStatus {
  REQUESTED
  PENDING_PROVIDER
  COMPLETED
  FAILED
  REJECTED
}

/// Who caused the audited event. JATA_SYSTEM = the orchestrator itself; JATA_OPERATOR =
/// internal administration, which never appears in the merchant POS (§73).
enum PaymentActorKind {
  MERCHANT_STAFF
  CUSTOMER
  JATA_SYSTEM
  JATA_OPERATOR
}

/// Where the business gets paid (§9). Belongs to exactly one tenant.
model PaymentDestination {
  id                     String                    @id @default(cuid())
  businessId             String
  business               Business                  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  kind                   PaymentDestinationKind
  provider               PaymentProviderKey
  /// Masked label for display, e.g. "M-PESA Till •••4567".
  label                  String?
  /// The number the merchant entered: till, paybill, pochi, bank account or Paystack reference.
  providerDestinationId  String
  /// PayBill business/account reference ("" when not applicable — keeps the unique key usable).
  providerAccountRef     String                    @default("")
  bankName               String?
  accountName            String?
  currency               String                    @default("KES")
  /// Capabilities actually available for this destination (§8, §88). Never invented.
  capabilities           String[]
  status                 PaymentDestinationStatus @default(UNVERIFIED)
  /// How the status was earned: FORMAT | PROVIDER | LIVE (§52).
  verificationSource     String?
  isPrimary              Boolean                   @default(false)
  isActive               Boolean                   @default(true)
  verifiedAt             DateTime?
  connectedAt            DateTime?
  disconnectedAt         DateTime?
  lastEventAt            DateTime?
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt

  transactions           PaymentTransaction[]
  auditEvents            PaymentAuditEvent[]

  @@unique([businessId, provider, providerDestinationId, providerAccountRef])
  @@index([businessId, isActive])
  @@index([businessId, isPrimary])
}

/// JATA's own connection to a provider for one tenant (§2, §12). The merchant never sees
/// credentials, callback URLs or keys: this row records only status and what JATA may do.
model PaymentProviderConnection {
  id                 String                    @id @default(cuid())
  businessId         String
  business           Business                  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  provider           PaymentProviderKey
  status             PaymentDestinationStatus @default(UNVERIFIED)
  /// Provider-side identifier JATA holds for this tenant (subaccount code, shortcode, …).
  /// Never a secret: secrets stay in JATA's server environment (§58).
  providerConnectionId String?
  displayName        String?
  capabilities       String[]
  healthy            Boolean                   @default(false)
  /// Plain-language state for the merchant, never a technical error (§53, §86).
  detail             String?
  lastEventAt        DateTime?
  lastHealthyAt      DateTime?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  @@unique([businessId, provider])
  @@index([businessId, status])
}

/// One payment: JATA's request, the provider's answer and JATA's verification (§32, §101).
model PaymentTransaction {
  id                    String                   @id @default(cuid())
  /// The merchant-visible JATA payment id, e.g. JTP-20261004-1048-X8K2 (§32).
  jataPaymentId         String                   @unique
  businessId            String
  business              Business                 @relation(fields: [businessId], references: [id], onDelete: Cascade)
  destinationId         String?
  destination           PaymentDestination?      @relation(fields: [destinationId], references: [id], onDelete: SetNull)
  provider              PaymentProviderKey
  status                PaymentTransactionStatus @default(CREATED)
  /// JATA's reference handed to the provider (§64).
  providerReference     String?
  /// The provider's own transaction id — the authoritative external identity (§32, §33).
  /// For M-PESA STK this remains the CheckoutRequestID correlation handle.
  providerTransactionId String?
  /// Actual M-PESA STK receipt from the authenticated callback; never a correlation substitute.
  providerReceipt       String?
  idempotencyKey        String                   @unique
  /// How the payment was made: MPESA_STK | MPESA_PAYBILL | MPESA_QR | CARD | BANK_TRANSFER …
  method                String?
  amountMinor           Int
  amountPaidMinor       Int                      @default(0)
  amountRefundedMinor   Int                      @default(0)
  currency              String                   @default("KES")
  customerName          String?
  customerPhoneMasked   String?
  posCustomerId         String?
  /// The POS sale this payment settled, once it is confirmed (§25). Unique: one payment can
  /// never settle two sales, and a retry can never settle the same sale twice (§33, §98).
  posSaleId             String?                  @unique
  posSale               PosSale?                 @relation(fields: [posSaleId], references: [id], onDelete: SetNull)
  /// The service/order this payment is for, when it is not a counter sale.
  orderId               String?
  /// Server-priced settlement context (cart lines, actor, channel). Never trusted from the browser.
  paymentContext        Json?
  receiptNumber         String?
  /// Unguessable token for the public receipt verification page (§38, §83).
  receiptToken          String?                  @unique
  receiptGeneratedAt    DateTime?
  failureCode           String?
  /// Plain-language failure shown to the merchant (§86).
  failureReason         String?
  /// When JATA stops waiting for a confirmation that never came (§68).
  expiresAt             DateTime?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  requestedAt           DateTime?
  providerAcceptedAt    DateTime?
  providerConfirmedAt   DateTime?
  jataVerifiedAt        DateTime?
  paidAt                DateTime?
  merchantNotifiedAt    DateTime?
  customerNotifiedAt    DateTime?
  reconciledAt          DateTime?

  attempts        PaymentAttempt[]
  events          PaymentEvent[]
  notifications   PaymentNotification[]
  refunds         Refund[]
  reconciliations PaymentReconciliation[]
  auditEvents     PaymentAuditEvent[]

  @@unique([provider, providerReference])
  @@unique([provider, providerTransactionId])
  @@index([businessId, createdAt])
  @@index([businessId, status])
  @@index([status, expiresAt])
  @@index([businessId, posSaleId])
}

/// Every call JATA made to a provider for this payment (§101). Attempts are evidence, not state.
model PaymentAttempt {
  id               String               @id @default(cuid())
  businessId       String
  transactionId    String
  transaction      PaymentTransaction   @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  provider         PaymentProviderKey
  attemptNumber    Int                  @default(1)
  status           PaymentAttemptStatus @default(REQUESTED)
  requestReference String?
  providerReference String?
  errorCode        String?
  errorMessage     String?
  latencyMs        Int?
  createdAt        DateTime             @default(now())

  @@unique([transactionId, attemptNumber])
  @@index([businessId, createdAt])
}

/// A provider event as JATA received it (§24, §34, §35). `(provider, providerEventId)` is the
/// database-level replay guard: one provider event can never be processed twice (§33).
model PaymentEvent {
  id                String             @id @default(cuid())
  provider          PaymentProviderKey
  providerEventId   String
  eventType         String
  businessId        String?
  transactionId     String?
  transaction       PaymentTransaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  signatureVerified Boolean            @default(false)
  status            PaymentEventStatus @default(RECEIVED)
  /// Sanitised provider payload: enough to audit, never credentials, PINs or full personal data (§116).
  payload           Json?
  providerReference String?
  errorCode         String?
  receivedAt        DateTime           @default(now())
  processedAt       DateTime?

  @@unique([provider, providerEventId])
  @@index([provider, status, receivedAt])
  @@index([businessId, receivedAt])
}

/// Merchant and customer notifications for a payment (§26, §27, §100). Notification failure
/// never changes a payment's status (§66).
model PaymentNotification {
  id             String                        @id @default(cuid())
  businessId     String
  business       Business                      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  transactionId  String?
  transaction    PaymentTransaction?           @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  audience       PaymentNotificationAudience
  channel        String                        @default("POS")
  recipientMasked String?
  title          String
  message        String
  status         PaymentNotificationStatus     @default(PENDING)
  attempts       Int                           @default(0)
  maxAttempts    Int                           @default(3)
  lastError      String?
  /// Stable per event so a retry can never send the same message twice (§66).
  idempotencyKey String                        @unique
  scheduledAt    DateTime?
  sentAt         DateTime?
  createdAt      DateTime                      @default(now())
  updatedAt      DateTime                      @updatedAt

  @@index([businessId, createdAt])
  @@index([status, scheduledAt])
  @@index([transactionId])
}

/// JATA's reconciliation of a payment against the provider's own record (§29, §42, §43).
model PaymentReconciliation {
  id                   String                       @id @default(cuid())
  businessId           String
  business             Business                     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  transactionId        String?
  transaction          PaymentTransaction?          @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  provider             PaymentProviderKey
  providerReference    String?
  result               PaymentReconciliationResult
  expectedAmountMinor  Int?
  receivedAmountMinor  Int?
  differenceMinor      Int                          @default(0)
  currency             String                       @default("KES")
  notes                String?                      @db.Text
  /// Manual matching is a named, reasoned, audited act — never a silent attach (§44).
  matchedByActorId     String?
  matchedByActorName   String?
  matchedReason        String?
  resolvedAt           DateTime?
  createdAt            DateTime                     @default(now())

  @@index([businessId, result, createdAt])
  @@index([businessId, createdAt])
}

/// Refunds (§47). The original payment is never overwritten: every refund is its own row
/// and moves the running refunded total forward (§114).
model Refund {
  id                String            @id @default(cuid())
  businessId        String
  business          Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  transactionId     String
  transaction       PaymentTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  provider          PaymentProviderKey
  amountMinor       Int
  currency          String            @default("KES")
  status            RefundStatus      @default(REQUESTED)
  reason            String
  initiatedById     String?
  initiatedByName   String?
  providerReference String?
  failureReason     String?
  requestedAt       DateTime          @default(now())
  completedAt       DateTime?
  createdAt         DateTime          @default(now())

  @@index([businessId, createdAt])
  @@index([transactionId])
  @@index([provider, providerReference])
}

/// Payment audit trail (§60, §98). Immutable through normal interfaces — a database trigger
/// blocks updates, so a merchant UI or API bug cannot rewrite the history of money.
model PaymentAuditEvent {
  id            String            @id @default(cuid())
  businessId    String
  business      Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  transactionId String?
  transaction   PaymentTransaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  destinationId String?
  destination   PaymentDestination? @relation(fields: [destinationId], references: [id], onDelete: SetNull)
  actorKind     PaymentActorKind
  actorId       String?
  actorName     String?
  action        String
  summary       String
  beforeState   Json?
  afterState    Json?
  reason        String?
  createdAt     DateTime          @default(now())

  @@index([businessId, createdAt])
  @@index([businessId, action])
  @@index([transactionId, createdAt])
}
