{
  "name": "jata-aftercall",
  "version": "1.0.0",
  "private": true,
  "description": "JATA AFTERCALL — lightweight after-interaction business conversion pages for Kenyan SMEs",
  "scripts": {
    "dev": "next dev --webpack -H 0.0.0.0",
    "build": "bash scripts/build.sh",
    "start": "next start -H 0.0.0.0",
    "lint": "eslint app components lib",
    "typecheck": "tsc --noEmit",
    "pretest": "node scripts/test/check-prisma-client.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run tests/e2e/interactive-business-journey.test.ts",
    "test:e2e:pos": "vitest run tests/e2e/business-pos-journey.test.ts",
    "test:db:migrations": "node scripts/test-local-postgres-migrations.mjs",
    "seed": "tsx prisma/seed.ts",
    "demo:restore": "tsx scripts/restore-demo-businesses.ts",
    "migrate": "bash scripts/migrate.sh",
    "postinstall": "bash scripts/lib/prisma-generate.sh || echo 'prisma generate skipped (offline)'",
    "test:browser:immersive": "node scripts/browser/immersive-preview.check.mjs",
    "check:models": "tsx scripts/erp/check-models.ts",
    "migrate:verify": "bash scripts/erp/migration-verify.sh all",
    "test:erp:pages": "node scripts/erp/erp-pages.check.mjs",
    "test:erp:visual": "node scripts/erp/erp-visual.check.mjs",
    "test:erp:visual:gallery": "node scripts/erp/erp-visual-gallery.mjs",
    "test:erp:layout-fixture": "node scripts/erp/erp-layout-fixture.check.mjs",
    "test:erp:tasks-page": "node scripts/erp/tasks-page.check.mjs",
    "test:db:erp": "vitest run tests/integration/erp-pro-postgres.test.ts tests/integration/erp-tasks-postgres.test.ts tests/integration/erp-notifications-postgres.test.ts tests/integration/erp-approvals-postgres.test.ts tests/integration/erp-procurement-postgres.test.ts tests/integration/erp-requisitions-postgres.test.ts",
    "test:browser:motion": "node scripts/browser/storefront-motion.check.mjs",
    "test:browser:layout": "node scripts/browser/fixture-layout.check.mjs",
    "test:browser:families": "node scripts/browser/storefront-families.check.mjs",
    "test:browser:media-local": "node scripts/browser/local-media.check.mjs",
    "test:browser:password-recovery-ui": "node scripts/browser/password-recovery-ui.check.mjs",
    "test:smoke:studio": "node scripts/browser/studio-production.smoke.mjs",
    "measure:studio-bundles": "node scripts/measure-website-studio-bundles.mjs",
    "test:browser:studio-authenticated": "node scripts/browser/studio-authenticated.check.mjs",
    "test:browser:studio-hydration": "tsx scripts/browser/studio-hydration.check.mts",
    "test:browser:hydration-race": "node scripts/browser/hydration-race.check.mjs",
    "test:browser:hydration-replay": "REPLAY_ASSERT=clean node scripts/browser/hydration-replay.check.mjs",
    "test:browser:hydration-replay:control": "REPLAY_EXPECT=reproduce node scripts/browser/hydration-replay.check.mjs",
    "test:browser:actionbar": "node scripts/browser/actionbar-layout.check.mjs",
    "diagnose:browser:replay-delay": "node scripts/browser/hydration-delayed-chunk.check.mjs",
    "test:browser:landing": "node scripts/browser/landing-showcase.check.mjs",
    "test:browser:autopilot-controls": "node scripts/browser/autopilot-controls.check.mjs",
    "test:browser:autopilot-activation": "node scripts/browser/autopilot-activation.check.mjs",
    "test:browser:pricing": "node scripts/browser/pricing-grid.check.mjs",
    "test:browser:premium-screenshots": "node scripts/browser/premium-screenshots.check.mjs",
    "test:landing": "vitest run tests/unit/landing-content.test.ts tests/unit/landing-motion.test.ts tests/unit/demo-showcase-band.test.ts",
    "test:browser:agents": "node scripts/browser/agent-status.check.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@prisma/client": "^5.22.0",
    "@tanstack/react-table": "^9.3.1",
    "bcryptjs": "^2.4.3",
    "jose": "^5.9.6",
    "lucide-react": "^1.56.0",
    "motion": "^14.1.0",
    "next": "16.4.2",
    "nodemailer": "10.1.6",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.186.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "pg": "8.23.1",
    "postcss": "8.5.28",
    "postcss-selector-parser": "7.1.6",
    "prisma": "^5.22.0",
    "puppeteer-core": "^25.13.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "overrides": {
    "postcss": "8.5.28",
    "source-map-js": "1.2.2",
    "brace-expansion@1": "1.1.21",
    "brace-expansion@5": "5.0.12",
    "postcss-selector-parser": "7.1.6"
  }
}
