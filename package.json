{
  "name": "jata-aftercall",
  "version": "1.0.0",
  "private": true,
  "description": "JATA AFTERCALL — lightweight after-interaction business conversion pages for Kenyan SMEs",
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "bash scripts/build.sh",
    "start": "next start -H 0.0.0.0",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run tests/e2e/interactive-business-journey.test.ts",
    "test:e2e:pos": "vitest run tests/e2e/business-pos-journey.test.ts",
    "seed": "tsx prisma/seed.ts",
    "demo:restore": "tsx scripts/restore-demo-businesses.ts",
    "migrate": "bash scripts/migrate.sh",
    "postinstall": "prisma generate || echo 'prisma generate skipped (offline)'"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "jose": "^5.9.6",
    "next": "15.5.26",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "15.5.26",
    "postcss": "8.5.28",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.6",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "overrides": {
    "postcss": "8.5.28"
  }
}
