{
  "name": "jata-aftercall",
  "version": "1.0.0",
  "private": true,
  "description": "JATA AFTERCALL — lightweight after-interaction business conversion pages for Kenyan SMEs",
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "bash scripts/build.sh",
    "start": "next start -H 0.0.0.0",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run tests/e2e/interactive-business-journey.test.ts",
    "test:e2e:pos": "vitest run tests/e2e/business-pos-journey.test.ts",
    "seed": "tsx prisma/seed.ts",
    "demo:restore": "tsx scripts/restore-demo-businesses.ts",
    "migrate": "bash scripts/migrate.sh",
    "postinstall": "prisma generate || echo 'prisma generate skipped (offline)'",
    "test:browser:immersive": "node scripts/browser/immersive-preview.check.mjs",
    "test:browser:motion": "node scripts/browser/storefront-motion.check.mjs",
    "test:browser:layout": "node scripts/browser/fixture-layout.check.mjs",
    "test:browser:families": "node scripts/browser/storefront-families.check.mjs",
    "test:browser:media-local": "node scripts/browser/local-media.check.mjs",
    "test:smoke:studio": "node scripts/browser/studio-production.smoke.mjs",
    "measure:studio-bundles": "node scripts/measure-website-studio-bundles.mjs",
    "test:browser:studio-authenticated": "node scripts/browser/studio-authenticated.check.mjs",
    "test:browser:studio-hydration": "tsx scripts/browser/studio-hydration.check.mts",
    "test:browser:hydration-race": "node scripts/browser/hydration-race.check.mjs"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@tanstack/react-table": "^9.3.1",
    "bcryptjs": "^2.4.3",
    "jose": "^5.9.6",
    "lucide-react": "^1.56.0",
    "motion": "^14.1.0",
    "next": "15.5.27",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.186.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "15.5.27",
    "postcss": "8.5.28",
    "postcss-selector-parser": "7.1.6",
    "prisma": "^5.22.0",
    "puppeteer-core": "^25.13.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "overrides": {
    "postcss": "8.5.28",
    "source-map-js": "1.2.2",
    "brace-expansion@1": "1.1.21",
    "brace-expansion@5": "5.0.12",
    "postcss-selector-parser": "7.1.6"
  }
}
